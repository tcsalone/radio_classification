# Source from the repo root before running macOS capture scripts:
#   source macos/env.defaults
#
# macOS standalone defaults (Ollama.app on standard port 11434, Metal GPU).
# Do not mix with WSL env that points at :11435.

export RADIO_CLASSIFIER_OLLAMA_HOST="${RADIO_CLASSIFIER_OLLAMA_HOST:-http://127.0.0.1:11434}"
export RADIO_CLASSIFIER_OLLAMA_KEEP_ALIVE="${RADIO_CLASSIFIER_OLLAMA_KEEP_ALIVE:--1}"
export WHISPER_DEVICE="${WHISPER_DEVICE:-cpu}"
export WHISPER_COMPUTE_TYPE="${WHISPER_COMPUTE_TYPE:-int8}"
export DEVICE_INDEX="${DEVICE_INDEX:-0}"
export FREQUENCY="${FREQUENCY:-105300000}"
export SAMPLE_RATE="${SAMPLE_RATE:-48000}"
export BLOCK_SECONDS="${BLOCK_SECONDS:-1800}"
export RETENTION_DAYS="${RETENTION_DAYS:-7}"
